<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Crear un Diario para el Cierre Fiscal -->
    <record id="journal_fiscal_closing" model="account.journal">
        <field name="name">Cierre Fiscal</field>
        <field name="code">CF</field>
        <field name="type">general</field> <!-- Tipo de diario: General -->
        <field name="company_id" ref="base.main_company"/> <!-- Asociado a la compañía principal -->
    </record>

    <!-- Plantilla de Cierre Fiscal -->
    <record id="fiscal_year_closing_template_cuba" model="account.fiscalyear.closing.template">
        <field name="name">Plantilla de Cierre Fiscal Cuba</field>
        <field name="chart_template_ids" eval="[(6, 0, [ref('l10n_cu.l10n_cu_chart_template_common')])]"/> <!-- Plantilla de cuentas de Cuba -->
    </record>

    <!-- Configuración de Movimientos para el Cierre de Ingresos -->
    <record id="fiscal_year_closing_config_income_cuba" model="account.fiscalyear.closing.config.template">
        <field name="name">Cierre de Ingresos</field>
        <field name="code">income</field> <!-- Código único para esta configuración -->
        <field name="template_id" ref="fiscal_year_closing_template_cuba"/>
        <field name="move_date">last_ending</field> <!-- Fecha del movimiento: última fecha del período de cierre -->
        <field name="journal_id" ref="journal_fiscal_closing"/> <!-- Diario para los asientos de cierre -->
        <field name="move_type">closing</field> <!-- Tipo de movimiento: Cierre -->
        <field name="closing_type_default">balance</field> <!-- Tipo de cierre por defecto: Balance -->
    </record>

    <!-- Mapeo de Cuentas de Ingresos -->
    <record id="fiscal_year_closing_mapping_income_cuba" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Mapeo de Ingresos</field>
        <field name="template_config_id" ref="fiscal_year_closing_config_income_cuba"/>
        <field name="src_accounts">900.0000,914.0000,915.0000,916.0000,920.0000,923.0000,924.0000,925.0000,926.0000,928.0000,930.0000,950.0000,953.0000</field> <!-- Cuentas de ingresos -->
        <field name="dest_account">999.0000</field> <!-- Cuenta de destino: Resultados (999.0000) -->
    </record>

    <!-- Configuración de Movimientos para el Cierre de Gastos -->
    <record id="fiscal_year_closing_config_expense_cuba" model="account.fiscalyear.closing.config.template">
        <field name="name">Cierre de Gastos</field>
        <field name="code">expense</field> <!-- Código único para esta configuración -->
        <field name="template_id" ref="fiscal_year_closing_template_cuba"/>
        <field name="move_date">last_ending</field> <!-- Fecha del movimiento: última fecha del período de cierre -->
        <field name="journal_id" ref="journal_fiscal_closing"/> <!-- Diario para los asientos de cierre -->
        <field name="move_type">closing</field> <!-- Tipo de movimiento: Cierre -->
        <field name="closing_type_default">balance</field> <!-- Tipo de cierre por defecto: Balance -->
    </record>

    <!-- Mapeo de Cuentas de Gastos -->
    <record id="fiscal_year_closing_mapping_expense_cuba" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Mapeo de Gastos</field>
        <field name="template_config_id" ref="fiscal_year_closing_config_expense_cuba"/>
        <field name="src_accounts">800.0000,805.0000,810.0000,814.0000,818.0000,819.0000,822.0000,825.0000,826.0000,834.0000,835.0000,839.0000,840.0000,841.0000,843.0000,845.0000,849.0000,850.0000,855.0000,865.0000,867.0000,873.0000</field> <!-- Cuentas de gastos -->
        <field name="dest_account">999.0000</field> <!-- Cuenta de destino: Resultados (999.0000) -->
    </record>

    <!-- Configuración de Movimientos para el Cierre de Resultados -->
    <record id="fiscal_year_closing_config_results_cuba" model="account.fiscalyear.closing.config.template">
        <field name="name">Cierre de Resultados</field>
        <field name="code">results</field> <!-- Código único para esta configuración -->
        <field name="template_id" ref="fiscal_year_closing_template_cuba"/>
        <field name="move_date">last_ending</field> <!-- Fecha del movimiento: última fecha del período de cierre -->
        <field name="journal_id" ref="journal_fiscal_closing"/> <!-- Diario para los asientos de cierre -->
        <field name="move_type">closing</field> <!-- Tipo de movimiento: Cierre -->
        <field name="closing_type_default">balance</field> <!-- Tipo de cierre por defecto: Balance -->
    </record>

    <!-- Mapeo de Cuentas de Resultados -->
    <record id="fiscal_year_closing_mapping_results_cuba" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Mapeo de Resultados</field>
        <field name="template_config_id" ref="fiscal_year_closing_config_results_cuba"/>
        <field name="src_accounts">999.0000</field> <!-- Cuenta de origen: Resultados (999.0000) -->
        <field name="dest_account">999.1000</field> <!-- Cuenta de destino: Ganancias Retenidas (999.1000) -->
    </record>
</odoo>