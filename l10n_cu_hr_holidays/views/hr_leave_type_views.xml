<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View hr.leave.type form -->
    <record id="edit_holiday_status_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('flex-column')][1]/label[@for='include_public_holidays_in_duration']" position="before">
                <label for="is_settlement_type" class="me-4"/>
            </xpath>

            <!-- 2. Insertamos el Field en la columna de campos -->
            <xpath expr="//div[hasclass('flex-column')][2]/field[@name='include_public_holidays_in_duration']" position="before">
                <field name="is_settlement_type" class="mb-2" nolabel="1"/>
            </xpath>
        </field>
    </record>

  </odoo>