<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View hr.leave form -->
    <record id="hr_leave_view_form_inherit" model="ir.ui.view">
      <field name="name">hr.leave.view.form.inherit</field>
      <field name="model">hr.leave</field>
      <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
      <field name="arch" type="xml">
          <xpath expr="//field[@name='name']" position="after">
              <field name="is_settlement_enabled" invisible="1"/>
              <field name="is_settlement" invisible = "is_settlement_enabled == False"/>
              <field name="settlement_days" 
                    invisible = "is_settlement == False"
                    required = "is_settlement == True"/>
          </xpath>
      </field>
    </record>

  </odoo>