<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">

    <!-- Main Tax Report for Cuba -->
    <record id="tax_report_cuba" model="account.report">
        <field name="name">Cuba Tax Report</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.cu"/>
        <field name="filter_fiscal_position" eval="True"/>
        <field name="availability_condition">country</field>

        <!-- Columns -->
        <field name="column_ids">
            <record id="tax_report_cuba_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>

        <!-- Report Lines -->
        <field name="line_ids">

            <!-- 1. Corporate Income Tax (35%) -->
            <record id="tax_report_cuba_iue_35" model="account.report.line">
                <field name="name">Corporate Income Tax (35%)</field>
                <field name="code">iue35</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="tax_report_cuba_iue_35_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">IUE35</field>
                    </record>
                </field>
            </record>

            <!-- 2. Retail Sales or Services Tax (10%) -->
            <record id="tax_report_cuba_sales_10" model="account.report.line">
                <field name="name">Retail Sales or Services Tax (10%)</field>
                <field name="code">sales10</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="tax_report_cuba_sales_10_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">I10</field>
                    </record>
                </field>
            </record>

            <!-- 3. Labor Utilization Tax (5%) -->
            <record id="tax_report_cuba_labor_5" model="account.report.line">
                <field name="name">Labor Utilization Tax (5%)</field>
                <field name="code">labor5</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="tax_report_cuba_labor_5_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">FT5</field>
                    </record>
                </field>
            </record>

        </field>
    </record>
</odoo>
