<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_demo_company_cu" model="res.partner">
        <field name="name">CU Company</field>
        <field name="vat">0808080808</field>
        <field name="street">Gaspacho</field>
        <field name="street2">Mochilo</field>
        <field name="zip">10400</field>
        <field name="city">Valdepito del Botijo</field>
        <field name="state_id" ref="base.state_cu_son"/>
        <field name="country_id" ref="base.cu"/>
        <field name="phone">+53 2221 2345</field>
        <field name="email">info@company.cuexample.com</field>
        <field name="website">www.cuexample.com</field>
    </record>

    <record id="demo_company_cu" model="res.company">
        <field name="name">Cu Company</field>
        <field name="partner_id" ref="partner_demo_company_cu"/>
    </record>

    <record id="demo_bank_cu" model="res.partner.bank">
       <field name="acc_number">Cu47HABA0012345678210</field>
       <field name="partner_id" ref="partner_demo_company_cu"/>
       <field name="company_id" ref="demo_company_cu"/>
   </record>

    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('demo_company_cu')]"/>
    </function>

    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(4, ref('l10n_cu.demo_company_cu'))]}"/>
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>cu</value>
        <value model="res.company" eval="obj().env.ref('l10n_cu.demo_company_cu')"/>
    </function>
</odoo>
